# SpendSense Environment Configuration

# Option A: Groq API (Recommended for ultra-fast open-weight inference)
# Models: llama-3.1-8b-instant, llama-3.2-3b-preview, llama-3.2-1b-preview (all <= 10B parameters)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Option B: Hugging Face Inference API (Alternative open-weight provider)
# Models: meta-llama/Llama-3.2-3B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
HF_API_KEY=your_huggingface_api_token_here
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Default Financial Settings (Can also be adjusted in the UI)
DEFAULT_MONTHLY_BUDGET=1200.00
DEFAULT_SAVINGS_GOAL=150.00
